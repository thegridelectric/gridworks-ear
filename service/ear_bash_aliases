# universal-ear convenience aliases — pure spelling over systemctl/tail, no
# logic. Sourced from the ear login's ~/.bashrc at box setup; the sudoers
# drop-in (/etc/sudoers.d/ear) grants exactly these systemctl invocations.
alias earstart='sudo systemctl start ear'
alias earstop='sudo systemctl stop ear'
alias earrestart='sudo systemctl restart ear'
alias earstatus='systemctl status ear --no-pager'
alias earlog='tail -F "$HOME"/.local/state/gridworks/ear/log/state.txt'

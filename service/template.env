# One ear instance = one login on the box. Copy to
# /home/<login>/gridworks-ear/.env and fill in; run as
# ear@<login>.service. Store credentials live in the login's
# ~/.aws/credentials (profile "default"), not here.

# The service alias is this witness's identity: it drives the broker
# queue name AND is the last segment of every object key — unique per
# instance, left-right-dot, held constant across box moves. Dev values
# here; a production instance sets its world's (hw1.ear / hw1__1).
EAR_SERVICE_ALIAS=d1.ear
# First path segment of every object key: the world this ear witnesses.
EAR_WORLD_INSTANCE_ALIAS=d1__1
EAR_RABBIT__URL=<amqp url from the operator>
# The exchange this instance's queue binds with `#`: ear_tx is the
# universal audit tap; a scoped instance points at its slice instead.
EAR_CONSUME_EXCHANGE=ear_tx
EAR_S3__BUCKET_NAME=gwdev
# Empty endpoint_url = AWS S3; set it to aim the same boto3 client at any
# S3-compatible host (e.g. https://s3.us-east-005.backblazeb2.com, with
# EAR_S3__REGION_NAME to match).
EAR_S3__ENDPOINT_URL=

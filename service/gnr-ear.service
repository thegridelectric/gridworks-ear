[Unit]
Description=GridWorks gnr seed ear — audit witness on gnr_ear_tx (registry slice)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gnrear
# Repo root as CWD; the ear finds the repo's gitignored .env by walking up
# from here (python-dotenv).
WorkingDirectory=/home/gnrear/gridworks-ear
ExecStart=/home/gnrear/gridworks-ear/.venv/bin/ear listen
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

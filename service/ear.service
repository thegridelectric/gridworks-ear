[Unit]
Description=GridWorks universal ear — audit witness on ear_tx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ear
# Repo root as CWD; the ear finds the repo's gitignored .env by walking up
# from here (python-dotenv).
WorkingDirectory=/home/ear/gridworks-ear
ExecStart=/home/ear/gridworks-ear/.venv/bin/ear listen
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

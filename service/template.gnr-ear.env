# gnr seed ear — copy to /home/gnrear/gridworks-ear/.env and fill in.
# Secrets (broker URL) come from the operator; the B2 application key lives
# in the gnrear login's ~/.aws/credentials (profile "default"), not here.
# The service alias is this witness's identity: it drives the broker
# queue name AND is the last segment of every object key — so it must
# differ from the universal ear's. Held constant across box moves.
EAR_G_NODE_ALIAS=hw1.gnr.ear
EAR_WORLD_INSTANCE_ALIAS=hw1__1
EAR_UNIVERSE_TYPE_VALUE=Hybrid
# Hybrid-universe validation requires these too — copy the values from the
# current production .env.
EAR_MY_TIME_COORDINATOR_ALIAS=hw1.time
EAR_MY_SUPER_ALIAS=hw1.super1
EAR_RABBIT__URL=<amqps url from the operator>
EAR_CONSUME_EXCHANGE=gnr_ear_tx
EAR_S3__BUCKET_NAME=gw-seedstore
EAR_S3__ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
EAR_S3__REGION_NAME=us-east-005
